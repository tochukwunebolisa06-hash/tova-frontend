.about {
  overflow: hidden;
}

.about__eyebrow {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-bottom: 14px;
}

/* ---------- Hero ---------- */

.about__hero-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48px;
  padding: 90px 24px 70px;
}

.about__hero-copy {
  max-width: 460px;
  flex-shrink: 0;
}

.about__title {
  font-size: clamp(2.1rem, 4vw, 2.9rem);
  line-height: 1.2;
  margin-bottom: 20px;
}

.about__subtitle {
  color: var(--color-text-muted);
  font-size: 1rem;
  line-height: 1.65;
}

.about__hero-visual {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.about__hero-image {
  position: relative;
  width: 100%;
  max-width: 480px;
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: linear-gradient(150deg, #aecbe0 0%, #f1ede4 55%, #e8e3d6 100%);
  background-size: cover;
  background-position: center;
}

.about__hero-caption {
  position: absolute;
  right: 26px;
  bottom: 26px;
  text-align: right;
  font-family: var(--font-script);
  font-size: 1.35rem;
  color: #fff;
  line-height: 1.15;
  text-shadow: 0 2px 12px rgba(15, 35, 71, 0.35);
}

.about__hero-caption::after {
  content: "";
  display: block;
  width: 65%;
  height: 2px;
  margin: 5px 0 0 auto;
  background: #fff;
  opacity: 0.85;
}

/* ---------- Values ---------- */

.about__values {
  padding: 20px 0 70px;
}

.about__values-title {
  font-size: clamp(1.7rem, 3vw, 2.2rem);
  margin-bottom: 40px;
}

.about__values-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 28px;
}

.about__value-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--color-bg-soft);
  color: var(--color-navy);
  margin-bottom: 16px;
}

.about__value-icon svg {
  width: 20px;
  height: 20px;
}

.about__value-name {
  font-weight: 600;
  color: var(--color-navy);
  font-size: 0.95rem;
  margin-bottom: 6px;
}

.about__value-body {
  color: var(--color-text-muted);
  font-size: 0.85rem;
  line-height: 1.55;
}

/* ---------- Mission / Vision ---------- */

.about__mv-wrap {
  padding: 0 0 70px;
}

.about__mv {
  background: var(--color-soft-blue);
  border-radius: var(--radius-md);
  padding: 48px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
}

.about__mv-col + .about__mv-col {
  border-left: 1px solid rgba(22, 48, 92, 0.12);
  padding-left: 48px;
}

.about__mv-title {
  font-size: clamp(1.4rem, 2.4vw, 1.7rem);
  line-height: 1.3;
  margin-bottom: 14px;
}

.about__mv-body {
  color: var(--color-text-muted);
  font-size: 0.92rem;
  line-height: 1.6;
}

/* ---------- Quote ---------- */

.about__quote {
  width: 100%;
  aspect-ratio: 3 / 1;
  min-height: 300px;

  background-color: #142a48;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;

  color: #fff;
}

/* ---------- Tablet ---------- */

@media (max-width: 980px) {
  .about__quote {
    aspect-ratio: 3 / 1;
    min-height: 240px;
  }

  .about__mv {
    padding: 36px;
    gap: 36px;
  }

  .about__mv-col + .about__mv-col {
    padding-left: 36px;
  }
}

/* ---------- Mobile ----------
   Keeps the exact desktop composition (side-by-side hero, 5-column values,
   two-column mission/vision, full-bleed quote banner) and scales everything
   with vw units so the proportions hold on any phone width. Font sizes have
   rem floors so text stays readable on very small screens. */

@media (max-width: 640px) {
  .about__eyebrow {
    font-size: max(0.55rem, 2vw);
    letter-spacing: 0.14em;
    margin-bottom: 2.4vw;
  }

  /* Hero: copy left, image right */
  .about__hero-inner {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: 3vw;
    padding: 8vw 5vw 8vw 6vw;
  }

  .about__hero-copy {
    max-width: none;
    min-width: 0;
  }

  .about__title {
    font-size: max(1.05rem, 5.2vw);
    line-height: 1.18;
    margin-bottom: 3.4vw;
  }

  .about__subtitle {
    font-size: max(0.63rem, 2.65vw);
    line-height: 1.6;
  }

  .about__hero-visual {
    min-width: 0;
    justify-content: stretch;
  }

  .about__hero-image {
    max-width: none;
    aspect-ratio: 3 / 2.1;
    border-radius: 3vw;
  }

  .about__hero-caption {
    right: 4.5vw;
    bottom: 4vw;
    font-size: max(0.75rem, 3.4vw);
  }

  .about__hero-caption::after {
    height: 1.5px;
    margin-top: 1vw;
  }

  /* Values: five columns in a row */
  .about__values {
    padding: 2vw 0 8vw;
  }

  .about__values .container {
    padding-left: 6vw;
    padding-right: 4vw;
  }

  .about__values-title {
    font-size: max(1.1rem, 4.8vw);
    margin-bottom: 6vw;
  }

  .about__values-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2vw;
  }

  .about__value-icon {
    width: 9vw;
    height: 9vw;
    margin-bottom: 2.6vw;
  }

  .about__value-icon svg {
    width: 4.2vw;
    height: 4.2vw;
  }

  .about__value-name {
    font-size: max(0.6rem, 2.7vw);
    line-height: 1.25;
    margin-bottom: 1.2vw;
    overflow-wrap: break-word;
  }

  .about__value-body {
    font-size: max(0.56rem, 2.3vw);
    line-height: 1.45;
    overflow-wrap: break-word;
  }

  /* Mission / Vision: two columns with a divider */
  .about__mv-wrap {
    padding: 0 0 8vw;
  }

  .about__mv-wrap .container {
    padding-left: 4.4vw;
    padding-right: 4.4vw;
  }

  .about__mv {
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding: 5vw 4vw;
    border-radius: 3vw;
  }

  .about__mv-col {
    min-width: 0;
    padding: 0 3.4vw 0 0;
  }

  .about__mv-col + .about__mv-col {
    border-left: 1px solid rgba(22, 48, 92, 0.12);
    border-top: none;
    padding: 0 0 0 3.4vw;
  }

  .about__mv-title {
    font-size: max(0.95rem, 4vw);
    line-height: 1.25;
    margin-bottom: 2.4vw;
  }

  .about__mv-body {
    font-size: max(0.58rem, 2.45vw);
    line-height: 1.55;
  }

  /* Quote: full-bleed banner, same ratio at every width */
  .about__quote {
    aspect-ratio: 3 / 1;
    min-height: 0;
    padding: 0;
    background-size: contain;
    background-position: center;
  }
}
</file>

