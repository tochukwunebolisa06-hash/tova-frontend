  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(15, 35, 71, 0.1);
  transition: background 0.2s var(--ease), color 0.2s var(--ease), transform 0.15s var(--ease);
