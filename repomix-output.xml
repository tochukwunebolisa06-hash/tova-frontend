}

.tt-carousel__arrow svg {
  width: 18px;
  height: 18px;
}

.tt-carousel__dots {
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: 160px;
  overflow: hidden;
}

.tt-carousel__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #c3cde0;
  flex-shrink: 0;
  transition: background 0.2s var(--ease), width 0.25s var(--ease);
}

.tt-carousel__dot--active {
